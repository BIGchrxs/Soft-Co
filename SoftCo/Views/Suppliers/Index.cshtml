@model List<SoftCo.Models.Supplier>
@using SoftCo.Models
@using SoftCo.Data
@{
    ViewData["Title"] = "Suppliers";
    ViewData["Description"] = "The people and partners behind every order.";
    var counts = ViewBag.OrderCounts as Dictionary<int, int> ?? new();
    var type = ViewBag.Type as SupplierType?;
}

@await Html.PartialAsync("_Flash")

<div class="sc-kpis">
    <div class="sc-kpi"><p class="sc-label">Supplier partners</p><p class="sc-kpi-value">@Model.Count.ToString("D2")</p><p class="sc-kpi-caption">Partners in this view</p></div>
    <div class="sc-kpi"><p class="sc-label">Supplier orders</p><p class="sc-kpi-value">@Model.Sum(s => counts.GetValueOrDefault(s.Id)).ToString("D2")</p><p class="sc-kpi-caption">Orders linked to these partners</p></div>
    <div class="sc-kpi"><p class="sc-label">Service providers</p><p class="sc-kpi-value">@Model.Count(s => s.Type == SupplierType.ServiceProvider).ToString("D2")</p><p class="sc-kpi-caption">Freight and logistics partners in this view</p></div>
</div>

<div class="sc-card">
    <div class="sc-card-head">
        <div class="sc-tabs">
            <a class="@(type == null ? "active" : "")" asp-action="Index">All</a>
            <a class="@(type == SupplierType.Manufacturer ? "active" : "")" asp-action="Index" asp-route-type="@SupplierType.Manufacturer">Manufacturers</a>
            <a class="@(type == SupplierType.ServiceProvider ? "active" : "")" asp-action="Index" asp-route-type="@SupplierType.ServiceProvider">Service providers</a>
        </div>
        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Procurement) || User.IsInRole(Roles.Finance))
        {
            <a class="btn btn-primary" asp-action="Create">New supplier</a>
        }
    </div>

    <div class="sc-table-wrap">
        <table class="sc-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Country</th>
                    <th>Currency</th>
                    <th class="sc-num">Orders</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td><a asp-controller="Orders" asp-action="Index" asp-route-SupplierId="@s.Id">@s.Name</a> @if (!s.IsActive) { <span class="sc-badge">Inactive</span> }</td>
                    <td class="sc-muted">@s.Type.Label()</td>
                    <td class="sc-muted">@(s.Country ?? "—")</td>
                    <td>@s.DefaultCurrencyCode</td>
                    <td class="sc-num">@(counts.TryGetValue(s.Id, out var c) ? c : 0)</td>
                    <td>
                        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Procurement) || User.IsInRole(Roles.Finance))
                        { <a asp-action="Edit" asp-route-id="@s.Id" aria-label="Edit @s.Name">Edit</a> }
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            { <tr><td colspan="6" class="sc-empty">No suppliers in this view. Choose another supplier type or add a supplier.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
